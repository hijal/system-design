{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "system-design",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"BUN_VERSION": "1.4.2"
	},
	"upload_source_maps": true
}
